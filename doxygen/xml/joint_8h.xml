      <memberdef kind="define" id="joint_8h_1a292ca54fa46995e81a58e6432a23a114" prot="public" static="no">
        <name>DUMP_BUFFER</name>
        <param><defname>buffer</defname></param>
        <param><defname>size</defname></param>
        <initializer>  {                                   \
    Serial.print(&quot;Buffer dump: &quot;);    \
    for (size_t i = 0; i &lt; size; i++) \
    {                                 \
      Serial.print(buffer[i], HEX);   \
      Serial.print(&quot; &quot;);              \
    }                                 \
    Serial.println();                 \
  }</initializer>
