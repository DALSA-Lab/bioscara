    <briefdescription>
<para>Low level utility for I2C communication on Raspberry Pi using lgpio library. </para>
    </briefdescription>
    <detaileddescription>
<para><simplesect kind="author"><para>sbstorz </para>
</simplesect>
<simplesect kind="version"><para>0.1 </para>
</simplesect>
<simplesect kind="date"><para>2025-05-28</para>
</simplesect>
<simplesect kind="copyright"><para>Copyright (c) 2025</para>
</simplesect>
