<codeline><highlight class="normal"><ref refid="joint_8h_1a018130d8f5ce298859605a5c8e1320ee" kindref="member">sudo</ref><sp/><ref refid="joint_8h_1a018130d8f5ce298859605a5c8e1320ee" kindref="member">apt</ref><sp/><ref refid="joint_8h_1a018130d8f5ce298859605a5c8e1320ee" kindref="member">install</ref><sp/>-<ref refid="joint_8h_1a018130d8f5ce298859605a5c8e1320ee" kindref="member">y</ref><sp/><ref refid="joint_8h_1a018130d8f5ce298859605a5c8e1320ee" kindref="member">swig</ref></highlight></codeline>
<codeline><highlight class="normal"><ref refid="joint_8h_1a018130d8f5ce298859605a5c8e1320ee" kindref="member">wget</ref><sp/><ref refid="joint_8h_1a018130d8f5ce298859605a5c8e1320ee" kindref="member">https</ref>:</highlight><highlight class="comment">//github.com/joan2937/lg/archive/master.zip</highlight><highlight class="normal"></highlight></codeline>
