      <memberdef kind="function" id="classbioscara__hardware__drivers_1_1BaseGripper_1a5e48cae19cd98b836e874370384fd7f0" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type></type>
